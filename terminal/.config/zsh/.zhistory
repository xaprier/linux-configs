const sql = require('mssql');\
const config = require('./db.js');\
\
async function checkUser() {}\
  try {}\
    await sql.connect(config);\
    const result = await sql.query`SELECT TOP 5 userId, email, userRole FROM Users ORDER BY userId`;\
    console.log('First 5 users:');\
    console.log(result.recordset);\
    \
    const admin = await sql.query`SELECT userId, email, userRole FROM Users WHERE email = 'seymenkalkan@gmail.com'`;\
    console.log('\nAdmin user:');\
    console.log(admin.recordset);\
  } catch (err) {}\
    console.error('Error:', err.message);\
  } finally {}\
    await sql.close();\
  }\
}\
\
checkUser();\
