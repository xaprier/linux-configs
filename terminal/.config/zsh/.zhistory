-- Flight Booking System - Seed Data: Flights & FlightSegments\
-- Generates 30 days of test flights\
-- Date: October 18, 2025\
\
USE DB_VTYS_Project_THY;\
GO\
\
PRINT 'Seeding Flights for 30 days...';\
\
DECLARE @startDate DATE = CAST(GETDATE() AS DATE);\
DECLARE @daysToGenerate INT = 30;\
DECLARE @currentDay INT = 0;\
DECLARE @currentDate DATE;\
DECLARE @totalFlights INT = 0;\
DECLARE @flightCounter INT;\
DECLARE @flightId INT;\
DECLARE @departureHour INT;\
DECLARE @departureTime DATETIME2;\
DECLARE @arrivalTime DATETIME2;\
DECLARE @flightNumber VARCHAR(10);\
\
WHILE @currentDay < @daysToGenerate\
BEGIN\
    SET @currentDate = DATEADD(DAY, @currentDay, @startDate);\
    \
    SET @flightCounter = 0;\
    WHILE @flightCounter < 12\
    BEGIN\
        SET @departureHour = 6 + (@flightCounter * 14 / 12);\
        SET @departureTime = DATEADD(HOUR, @departureHour, @currentDate);\
        SET @departureTime = DATEADD(MINUTE, ABS(CHECKSUM(NEWID())) % 60, @departureTime);\
        SET @arrivalTime = DATEADD(MINUTE, 60, @departureTime);\
        SET @flightNumber = 'TK0103' + RIGHT('0' + CAST((@flightCounter + 1) AS VARCHAR), 1);\
        \
        INSERT INTO Flights (flightNumber, airlineId, basePrice, status, availableSeats, numberOfSegments, isDirectFlight, createdAt, updatedAt)\
        VALUES (@flightNumber, 1, 150.00, 'scheduled', 174, 1, 1, GETDATE(), GETDATE());\
        SET @flightId = SCOPE_IDENTITY();\
        \
        INSERT INTO FlightSegments (flightId, originAirportId, destinationAirportId, departureTime, arrivalTime, segmentOrder, aircraftId, segmentDuration, availableSeats, createdAt, updatedAt)\
        VALUES (@flightId, 1, 3, @departureTime, @arrivalTime, 1, 1, 60, 174, GETDATE(), GETDATE());\
        \
        SET @flightCounter = @flightCounter + 1;\
        SET @totalFlights = @totalFlights + 1;\
    END\
    \
    SET @flightCounter = 0;\
    WHILE @flightCounter < 15\
    BEGIN\
        SET @departureHour = 6 + (@flightCounter * 14 / 15);\
        SET @departureTime = DATEADD(HOUR, @departureHour, @currentDate);\
        SET @departureTime = DATEADD(MINUTE, ABS(CHECKSUM(NEWID())) % 60, @departureTime);\
        SET @arrivalTime = DATEADD(MINUTE, 75, @departureTime);\
        SET @flightNumber = 'TK0105' + RIGHT('00' + CAST((@flightCounter + 1) AS VARCHAR), 2);\
        \
        INSERT INTO Flights (flightNumber, airlineId, basePrice, status, availableSeats, numberOfSegments, isDirectFlight, createdAt, updatedAt)\
        VALUES (@flightNumber, 1, 200.00, 'scheduled', 192, 1, 1, GETDATE(), GETDATE());\
        SET @flightId = SCOPE_IDENTITY();\
        \
        INSERT INTO FlightSegments (flightId, originAirportId, destinationAirportId, departureTime, arrivalTime, segmentOrder, aircraftId, segmentDuration, availableSeats, createdAt, updatedAt)\
        VALUES (@flightId, 1, 5, @departureTime, @arrivalTime, 1, 4, 75, 192, GETDATE(), GETDATE());\
        \
        SET @flightCounter = @flightCounter + 1;\
        SET @totalFlights = @totalFlights + 1;\
    END\
    \
    SET @flightCounter = 0;\
    WHILE @flightCounter < 4\
    BEGIN\
        SET @departureHour = 10 + (@flightCounter * 6);\
        SET @departureTime = DATEADD(HOUR, @departureHour, @currentDate);\
        SET @departureTime = DATEADD(MINUTE, ABS(CHECKSUM(NEWID())) % 60, @departureTime);\
        SET @arrivalTime = DATEADD(MINUTE, 240, @departureTime);\
        SET @flightNumber = 'TK1031' + RIGHT('0' + CAST((@flightCounter + 1) AS VARCHAR), 1);\
        \
        INSERT INTO Flights (flightNumber, airlineId, basePrice, status, availableSeats, numberOfSegments, isDirectFlight, createdAt, updatedAt)\
        VALUES (@flightNumber, 1, 350.00, 'scheduled', 360, 1, 1, GETDATE(), GETDATE());\
        SET @flightId = SCOPE_IDENTITY();\
        \
        INSERT INTO FlightSegments (flightId, originAirportId, destinationAirportId, departureTime, arrivalTime, segmentOrder, aircraftId, segmentDuration, availableSeats, createdAt, updatedAt)\
        VALUES (@flightId, 1, 31, @departureTime, @arrivalTime, 1, 7, 240, 360, GETDATE(), GETDATE());\
        \
        SET @flightCounter = @flightCounter + 1;\
        SET @totalFlights = @totalFlights + 1;\
    END\
    \
    IF (@currentDay + 1) % 5 = 0\
        PRINT '  Processed ' + CAST(@currentDay + 1 AS VARCHAR) + ' days - Total: ' + CAST(@totalFlights AS VARCHAR) + ' flights';\
    \
    SET @currentDay = @currentDay + 1;\
END\
\
PRINT 'Flight generation complete! Total flights: ' + CAST(@totalFlights AS VARCHAR);\
GO\
EOF
