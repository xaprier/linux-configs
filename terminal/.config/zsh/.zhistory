: 1765108816:0;cd "/mnt/Shared/Ders/AtatÃ¼rk Ãƒ¼niversitesi/Bilgisayar MÃ¼hendisliÄƒ¿i/DÃ¶nem 3/VTYS/VTYS PROJE/frontend/src/services" && cat > reservationService.ts << 'EOFMARKER'\
/**\
 * Reservation Service\
 * Maps to backend /api/reservations routes (reservation.routes.js)\
 * Includes check-in functionality\
 */\
\
import apiClient from './api'\
\
// ============================================================================\
// TYPE DEFINITIONS\
// ============================================================================\
\
export interface Passenger {}\
  passengerId?: number\
  firstName: string\
  lastName: string\
  dateOfBirth: string\
  nationality: string\
  passportNumber: string\
  passengerType: 'adult' | 'young' | 'child' | 'infant'\
  seatClass: 'economy' | 'business' | 'first'\
  seatId?: number | null\
  seatNumber?: string | null\
  flightId?: number\
  reservationFlightId?: number\
}\
\
export interface FlightSegment {}\
  flightId: number\
  flightNumber?: string\
  seatClass: 'economy' | 'business' | 'first'\
  direction?: 'outbound' | 'return'\
  originCode?: string\
  destCode?: string\
  departureTime?: string\
  arrivalTime?: string\
  price?: number\
}\
\
export interface Reservation {}\
  reservationId: number\
  reservationCode: string\
  userId: number\
  totalAmount: number\
  currency: string\
  status: 'pending' | 'confirmed' | 'cancelled' | 'checked_in' | 'auto_checked_in' | 'completed'\
  createdAt: string\
  updatedAt: string\
  cancellationDate?: string | null\
}\
\
export interface ReservationWithDetails extends Reservation {}\
  passengers: Passenger[]\
  segments: FlightSegment[]\
  flights?: any[]\
}\
\
export interface CreateReservationPayload {}\
  passengers: Passenger[]\
  outbound?: {}\
    segments: FlightSegment[]\
  }\
  inbound?: {}\
    segments: FlightSegment[]\
  }\
}\
\
export interface PricePreviewPayload {}\
  passengers: Passenger[]\
  outbound?: {}\
    segments: FlightSegment[]\
  }\
  inbound?: {}\
    segments: FlightSegment[]\
  }\
}\
\
export interface PricePreviewResponse {}\
  success: boolean\
  message: string\
  data: {}\
    totalAmount: number\
    currency: string\
    breakdown: {}\
      passengers: Array<{}\
        passengerId?: number\
        firstName: string\
        lastName: string\
        passengerType: string\
        seatClass: string\
        subtotal: number\
      }>\
      segments: Array<{}\
        flightId: number\
        flightNumber: string\
        originCode: string\
        destCode: string\
        direction: string\
        basePrice: number\
        passengerPrices: Array<{}\
          passengerId?: number\
          price: number\
        }>\
      }>\
    }\
  }\
}\
\
export interface ReservationResponse {}\
  success: boolean\
  message: string\
  data: {}\
    reservationId: number\
    reservationCode: string\
    totalAmount: number\
    currency: string\
    status: string\
  }\
}\
\
export interface ReservationListResponse {}\
  success: boolean\
  data: Reservation[]\
}\
\
export interface ReservationDetailsResponse {}\
  success: boolean\
  data: ReservationWithDetails\
}\
\
export interface CheckInPassengerData {}\
  passengerId: number\
  flightId: number\
  seatId: number\
}\
\
export interface CheckInRequest {}\
  passengers: CheckInPassengerData[]\
}\
\
export interface CheckInResponse {}\
  success: boolean\
  message: string\
  data: {}\
    checkIns: Array<{}\
      passengerId: number\
      flightId: number\
      seatId: number\
      checkInId: number\
      checkInTime: string\
      checkInStatus: 'checked_in' | 'auto_checked_in'\
      message: string\
      success: boolean\
    }>\
    successful?: any[]\
    failed?: any[]\
  }\
}\
\
export interface CheckInAvailableReservation {}\
  reservationId: number\
  reservationCode: string\
  flightNumber: string\
  departureTime: string\
  originCode: string\
  destCode: string\
  originCity: string\
  destCity: string\
  hoursUntilDeparture: number\
  passengersNotCheckedIn: number\
  numberOfPassengers: number\
}\
\
export interface CheckInAvailableResponse {}\
  success: boolean\
  data: CheckInAvailableReservation[]\
}\
\
export interface CancellationResponse {}\
  success: boolean\
  message: string\
  data?: {}\
    reservationId: number\
    status: string\
    cancellationFee?: number\
    refundAmount?: number\
  }\
}\
\
// ============================================================================\
// API FUNCTIONS (maps to reservation.routes.js)\
// ============================================================================\
\
/**\
 * POST /api/reservations\
 * Create a new reservation\
 */\
export const createReservation = async (payload: CreateReservationPayload): Promise<ReservationResponse> => {}\
  const response = await apiClient.post<ReservationResponse>('/reservations', payload)\
  return response.data\
}\
\
/**\
 * POST /api/reservations/price-preview\
 * Get price preview before creating reservation\
 */\
export const previewPrice = async (payload: PricePreviewPayload): Promise<PricePreviewResponse> => {}\
  const response = await apiClient.post<PricePreviewResponse>('/reservations/price-preview', payload)\
  return response.data\
}\
\
/**\
 * GET /api/reservations/check-in-available\
 * Get reservations available for check-in (24 hours before departure)\
 */\
export const getCheckInAvailable = async (): Promise<CheckInAvailableResponse> => {}\
  const response = await apiClient.get<CheckInAvailableResponse>('/reservations/check-in-available')\
  return response.data\
}\
\
/**\
 * GET /api/reservations\
 * Get user's reservations with optional status filter\
 */\
export const getUserReservations = async (status?: string): Promise<ReservationListResponse> => {}\
  const params = status ? { status } : {} }\
  const response = await apiClient.get<ReservationListResponse>('/reservations', { params }) })\
  return response.data\
}\
\
/**\
 * GET /api/reservations/:id\
 * Get reservation details by ID\
 */\
export const getReservationDetails = async (reservationId: number): Promise<ReservationDetailsResponse> => {}\
  const response = await apiClient.get<ReservationDetailsResponse>(`/reservations/${reservationId}`)\
  \
  // Normalize response structure\
  const payload = response.data && response.data.data ? response.data.data : {}\
  \
  const normalize = (v: any) => {}\
    if (v === null || v === undefined) return []\
    if (Array.isArray(v)) return v\
    if (typeof v === 'object') return [v]\
    return []\
  }\
\
  return {}\
    success: response.data?.success ?? true,\
    data: {}\
      ...payload.reservation,\
      passengers: normalize(payload.passengers),\
      segments: normalize(payload.segments),\
    } as ReservationWithDetails\
  }\
}\
\
/**\
 * DELETE /api/reservations/:id\
 * Cancel a reservation\
 */\
export const cancelReservation = async (reservationId: number): Promise<CancellationResponse> => {}\
  const response = await apiClient.delete<CancellationResponse>(`/reservations/${reservationId}`)\
  return response.data\
}\
\
/**\
 * POST /api/reservations/:id/check-in\
 * Check in passengers for a reservation\
 */\
export const checkInPassengers = async ()\
  reservationId: number,\
  checkInData: CheckInRequest\
): Promise<CheckInResponse> => {}\
  const response = await apiClient.post<CheckInResponse>()\
    `/reservations/${reservationId}/check-in`,\
    checkInData\
  )\
  return response.data\
}\
\
// ============================================================================\
// UTILITY FUNCTIONS\
// ============================================================================\
\
/**\
 * Check if reservation can be checked in\
 * (within 24 hours of departure, at least 1 hour before)\
 */\
export const canCheckIn = (departureTime: string): boolean => {}\
  const now = new Date()\
  const departure = new Date(departureTime)\
  const hoursUntilDeparture = (departure.getTime() - now.getTime()) / (1000 * 60 * 60)\
  \
  return hoursUntilDeparture >= 1 && hoursUntilDeparture <= 24\
}\
\
/**\
 * Calculate hours until departure\
 */\
export const getHoursUntilDeparture = (departureTime: string): number => {}\
  const now = new Date()\
  const departure = new Date(departureTime)\
  return (departure.getTime() - now.getTime()) / (1000 * 60 * 60)\
}\
\
export default {}\
  createReservation,\
  previewPrice,\
  getCheckInAvailable,\
  getUserReservations,\
  getReservationDetails,\
  cancelReservation,\
  checkInPassengers,\
  canCheckIn,\
  getHoursUntilDeparture,\
}\
EOFMARKER
