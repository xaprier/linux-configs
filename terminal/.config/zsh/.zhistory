: 1761818177:0;python3 - << 'PY'\
import re,os,json\
root='frontend/src'\
keys=set()\
pat=re.compile(r"\b(?:t|e|i18n\.t)\(\s*['\"]([A-Za-z0-9_\-{}./]+)['\"]")\
for dirpath,_,files in os.walk(root):\
    for f in files:\
        if f.endswith(('.js','.jsx','.ts','.tsx')):\
            p=os.path.join(dirpath,f)\
            s=open(p,encoding='utf-8').read()\
            for m in pat.finditer(s):\
                keys.add(m.group(1))\
print('Found',len(keys),'keys in source')\
\
en=json.load(open('frontend/src/locales/en.json',encoding='utf-8'))\
tr=json.load(open('frontend/src/locales/tr.json',encoding='utf-8'))\
\
def has_key(obj,path):\
    parts=path.split('.')\
    cur=obj\
    for p in parts:\
        # numeric keys like '1stop' valid\
        if isinstance(cur,dict) and p in cur:\
            cur=cur[p]\
        else:\
            return False\
    return True\
\
missing_en=[]\
missing_tr=[]\
for k in sorted(keys):\
    if not has_key(en,k):\
        missing_en.append(k)\
    if not has_key(tr,k):\
        missing_tr.append(k)\
\
print('Missing in en.json:',len(missing_en))\
for k in missing_en:\
    print(k)\
print('\nMissing in tr.json:',len(missing_tr))\
for k in missing_tr:\
    print(k)\
PY
