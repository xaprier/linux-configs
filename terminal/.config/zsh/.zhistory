: 1760600507:0;cd "/mnt/Shared/Ders/AtatÃ¼rk Ãƒ¼niversitesi/Bilgisayar MÃ¼hendisliÄƒ¿i/DÃ¶nem 3/VTYS/VTYS PROJE" && python3 << 'EOF'\
import re\
\
# Read file\
with open('database/seed/05_seed_flights.sql', 'r', encoding='utf-8') as f:\
    content = f.read()\
\
# Fix Flights INSERT - add createdAt, updatedAt to columns\
content = re.sub()\
    r'INSERT INTO Flights \(([^)]+)\)(?!\s*SELECT)',\
    lambda m: f'INSERT INTO Flights ({m.group(1)}, createdAt, updatedAt)' if 'createdAt' not in m.group(1) else m.group(0),\
    content\
)\
\
# Fix Flights VALUES - add GETDATE(), GETDATE()\
content = re.sub()\
    r"VALUES \(('[^']*'),\s*(\d+),\s*([\d.]+),\s*'([^']*)',\s*(\d+),\s*([01])\);",\
    r"VALUES ('\1', \2, \3, '\4', \5, \6, GETDATE(), GETDATE());",\
    content\
)\
\
# Fix FlightSegments INSERT - add createdAt, updatedAt to columns  \
content = re.sub()\
    r'INSERT INTO FlightSegments \(([^)]+)\)(?!\s*SELECT)',\
    lambda m: f'INSERT INTO FlightSegments ({m.group(1)}, createdAt, updatedAt)' if 'createdAt' not in m.group(1) else m.group(0),\
    content\
)\
\
# Fix FlightSegments VALUES - add GETDATE(), GETDATE() at the end\
content = re.sub()\
    r'VALUES \((@flightId[^)]+)\);',\
    r'VALUES (\1, GETDATE(), GETDATE());',\
    content\
)\
\
# Write back\
with open('database/seed/05_seed_flights.sql', 'w', encoding='utf-8') as f:\
    f.write(content)\
\
print("âƒ¼ƒ³ Fixed 05_seed_flights.sql")\
EOF
